---
import work01 from '../assets/portfolio/work/work-01.png';
import work02 from '../assets/portfolio/work/work-02.png';
import work03 from '../assets/portfolio/work/work-03.png';
import work04 from '../assets/portfolio/work/work-04.png';
import work05 from '../assets/portfolio/work/work-05.png';

const projects = [
  { src: work01, alt: 'Abstract blue folded forms over a light blue textured background.' },
  { src: work02, alt: 'Purple geometric pattern with circles, arrows, arches, and starbursts.' },
  { src: work03, alt: 'Hand holding a colorful illustrated newspaper over a geometric background.' },
  { src: work04, alt: 'Black graphic design booklet on yellow papers beside vinyl records.' },
  { src: work05, alt: 'Hand holding a smartphone displaying a designer portfolio beside a drink and small plant.' },
];
---

<section class="work section-block" aria-labelledby="work-title" data-work-carousel>
  <h2 id="work-title">My Work</h2>

  <div class="work-carousel" role="region" aria-roledescription="carousel" aria-labelledby="work-title">
    <ul id="work-carousel-track" class="work-carousel__track" role="list" data-carousel-track>
      {projects.map((project, index) => (
        <li
          class="work-carousel__slide"
          data-carousel-slide
          data-index={index}
        >
          <div
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${projects.length}`}
          >
            <img
              class="work-carousel__image"
              src={project.src.src}
              width={project.src.width}
              height={project.src.height}
              alt={project.alt}
              loading="lazy"
            />
          </div>
        </li>
      ))}
    </ul>

    <div class="work-carousel__controls" data-carousel-controls hidden>
      <button class="work-carousel__button" type="button" aria-label="Previous project" aria-controls="work-carousel-track" data-carousel-previous>
        <svg aria-hidden="true" viewBox="0 0 15 16" width="15" height="16" focusable="false">
          <path d="M8.75 1.75 2.5 8l6.25 6.25M2.75 8h10" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button class="work-carousel__button" type="button" aria-label="Next project" aria-controls="work-carousel-track" data-carousel-next>
        <svg aria-hidden="true" viewBox="0 0 15 16" width="15" height="16" focusable="false">
          <path d="m6.25 1.75 6.25 6.25-6.25 6.25M12.25 8h-10" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
    <p class="sr-only" aria-live="polite" aria-atomic="true" data-carousel-status></p>
  </div>
</section>

<script src="../scripts/work-carousel.ts"></script>
